<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${Kle(t.title)} · Meridian</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data: blob:; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'">
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:${n.canvas};color:${n.text};font-family:Arial,Helvetica,sans-serif}body{display:flex;flex-direction:column}main{flex:1;min-height:0;overflow:auto;display:flex;align-items:center;justify-content:center;padding:24px}main>svg{display:block;max-width:100%;max-height:100%;width:auto;height:auto}body.actual main{align-items:flex-start;justify-content:flex-start}body.actual main>svg{max-width:none;max-height:none;flex-shrink:0}footer{display:flex;gap:10px;justify-content:center;align-items:center;padding:14px 20px;border-top:1px solid ${n.border};background:${n.canvasRaised}}button{font:inherit;font-size:14px;padding:9px 14px;border-radius:7px;border:1px solid ${n.border};background:transparent;color:${n.text};cursor:pointer}button:hover,button:focus-visible{border-color:${n.accent};outline:none}button:focus-visible{outline:2px solid ${n.accent};outline-offset:3px}.paused svg *{animation-play-state:paused!important}.quiet{font-size:12px;color:${n.muted};margin-left:8px}@media(max-width:640px){main{padding:8px}footer{flex-wrap:wrap;gap:6px;padding:10px}.quiet{width:100%;text-align:center}}@media(prefers-reduced-motion:reduce){svg *{animation:none!important;transition:none!important}.meridian-motion{display:none!important}}@media print{footer{display:none}main{padding:0}body{height:auto}}
</style></head><body><main aria-label="Diagram presentation">${e}</main><footer><button id="pause" type="button">Pause motion</button><button id="replay" type="button">Replay</button><button id="fit" type="button">Actual size</button><button id="fullscreen" type="button">Fullscreen</button><span class="quiet" id="status" role="status">Space to pause · R to replay · F for fullscreen</span></footer>
<script>
const body=document.body,root=document.querySelector('main>svg'),pause=document.getElementById('pause');
function togglePause(){body.classList.toggle('paused');const paused=body.classList.contains('paused');pause.textContent=paused?'Resume motion':'Pause motion';document.querySelectorAll('svg').forEach(s=>{if(paused&&s.pauseAnimations)s.pauseAnimations();else if(s.unpauseAnimations)s.unpauseAnimations()})}
