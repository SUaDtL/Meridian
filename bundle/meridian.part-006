    color: ${e.actorTextColor??e.primaryTextColor};
    fill: ${e.actorTextColor??e.primaryTextColor};
    font-family: var(--mermaid-usecase-actor-font-family, ${e.fontFamily});
    font-size: var(--mermaid-usecase-actor-font-size, 14px);
    font-weight: var(--mermaid-usecase-actor-font-weight, normal);
