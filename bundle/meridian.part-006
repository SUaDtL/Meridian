  & .usecase-element .nodeLabel,
  & .usecase-label {
    color: ${e.primaryTextColor};
    fill: ${e.primaryTextColor};
    font-family: var(--mermaid-usecase-font-family, ${e.fontFamily});
    font-size: var(--mermaid-usecase-font-size, 12px);
    font-weight: var(--mermaid-usecase-font-weight, normal);
  }

  & .usecase-stereotype,
  & .usecase-business-marker {
    color: ${e.primaryTextColor};
    fill: ${e.primaryTextColor};
    stroke: ${t.border};
  }

  & .system-boundary rect.boundary-body,
  & .system-boundary rect.boundary-tab,
  & .system-boundary-package-tab {
    fill: ${t.boundaryBkg};
    stroke: ${t.boundaryBorder};
    stroke-width: 1px;
  }

  & .system-boundary-title text {
    fill: ${e.titleColor??e.primaryTextColor};
  }

  /* Only the span, never the <p> inside it: the renderer puts a user-supplied
     'color' on the span, and that has to stay inheritable by its children. */
  & .system-boundary-title span {
    color: ${e.titleColor??e.primaryTextColor};
  }

  & .usecase-note {
    fill: ${e.noteBkgColor};
    stroke: ${e.noteBorderColor};
    color: ${e.noteTextColor};
  }

  & .usecase-note .nodeLabel {
    color: ${e.noteTextColor};
    fill: ${e.noteTextColor};
  }

  & .usecase-json-table,
  & .usecase-json-table rect,
  & .usecase-json-cell {
    fill: ${e.mainBkg};
    stroke: ${e.nodeBorder??e.primaryColor};
  }

  & .usecase-json-title,
  & .usecase-json-key,
  & .usecase-json-value {
    color: ${e.primaryTextColor};
    fill: ${e.primaryTextColor};
  }

  & .relationship {
    fill: none;
    stroke: ${e.lineColor};
  }

  & .relationship-include,
  & .relationship-extend,
  & .relationship-note {
    stroke-dasharray: 3;
  }

  /* Include and extend are both dashed, which is a weak distinction at small sizes. The
     tokens default to \`lineColor\`, so a theme that does not set them is unchanged. */
  & .relationship-include {
    stroke: ${t.includeLine};
  }

  & .relationship-extend {
    stroke: ${t.extendLine};
  }

  & .relationship.edge-animation-fast,
  & .relationship.edge-animation-slow {
    stroke-linecap: round;
  }

  & .edgeLabel,
  & .edgeLabel p {
    background-color: ${e.edgeLabelBackground};
  }

  & .labelBkg {
    background-color: ${e.edgeLabelBackground};
    padding: 0 2px;
  }

  & .edgeLabel .label rect {
    fill: ${e.edgeLabelBackground};
  }

  & .relationship-label,
  & .edgeLabel {
    color: ${e.primaryTextColor};
    fill: ${e.primaryTextColor};
    font-family: ${e.fontFamily};
    font-size: 10px;
    font-weight: normal;
  }

  & .marker,
  & .marker.point,
  & .marker.circle,
  & .marker.cross {
    fill: ${e.lineColor};
    stroke: ${e.lineColor};
  }

  & .marker.extension {
    fill: ${e.mainBkg};
