{
  "name": "@arbiterforge/meridian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first Mermaid diagram studio for diagrams worth presenting.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "licenses": "node scripts/third-party-notices.mjs",
    "prebuild": "npm run licenses",
    "build": "tsc -b && vite build",
    "build:standalone": "npm run licenses && tsc -b && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "build:pages": "npm run build && node scripts/stage-pages.mjs",
    "typecheck": "tsc -b",
    "verify:legacy": "python3 scripts/assemble.py && python3 tests/validate.py",
    "verify:artifact": "python3 tests/validate.py --artifact site/index.html",
    "verify:standalone": "python3 tests/validate.py --artifact standalone/Meridian.html --standalone",
    "test:visual": "playwright test visual.spec.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@uiw/react-codemirror": "4.25.12",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "dompurify": "3.4.18",
    "lucide-react": "0.468.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
