        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "projectId",
        "revision",
        "contentHash",
        "stateDigest"
