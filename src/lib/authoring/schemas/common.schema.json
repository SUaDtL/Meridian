      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n\\u0000-\\u001f]*$",
      "$comment": "Also reject unpaired surrogates; count Unicode code points. Empty edge label uses its own schema."
    },
    "ElementRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "string",
          "pattern": "^new:[a-z][a-z0-9_]{0,31}$"
        }
      ]
    },
    "NewRef": {
      "type": "string",
      "pattern": "^new:[a-z][a-z0-9_]{0,31}$"
    },
    "Shape": {
      "enum": [
        "rect",
        "rounded",
        "stadium",
        "diamond",
        "circle",
        "cylinder",
        "hexagon"
      ]
    },
    "Role": {
      "enum": [
        "process",
        "decision",
        "service",
        "database",
        "queue",
        "external",
        "person",
        "boundary",
        "neutral"
